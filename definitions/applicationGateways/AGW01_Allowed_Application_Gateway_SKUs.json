{
    "type": "Microsoft.Authorization/policyDefinitions",
    "name": "SKUs",
    "mode": "All",
    "properties": {
        "description": "This policy defines the allowed Application Gateway SKUs within the assigned scope.",
        "metadata": {
            "category": "Cost Comply"
        },
        "policyRule": {
            "if": {
                "allOf": [
                    {
                        "field": "type",
                        "equals": "Microsoft.Network/applicationGateways"
                    },
                    {
                        "field": "Microsoft.Network/applicationGateways/sku.name",
                        "notIn": "[parameters('AllowedAppGatewaySKUs')]"
                    }
                ]
            },
            "then": {
                "effect": "[parameters('effect')]"
            }
        },
        "parameters": {
            "effect": {
                "type": "String",
                "allowedValues": [
                    "Audit",
                    "Deny",
                    "Disabled"
                ],
                "defaultValue": "Audit",
                "metadata": {
                    "description": "Specify the effect of the policy. Options are Audit, Deny, or Disabled.",
                    "displayName": "Effect"
                }
            },
            "AllowedAppGatewaySKUs": {
                "type": "Array",
                "allowedValues": [
                    "Basic",
                    "Standard_v2",
                    "WAF_v2"
                ],
                "defaultValue": [
                    "Basic"
                ],
                "metadata": {
                    "description": "Specify the allowed Application Gateway SKUs",
                    "displayName": "Application Gateway: Allowed SKUs"
                }
            }
        }
    }
}